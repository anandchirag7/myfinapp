# ============================================================================
# Paisa — Production Environment Variables
# ============================================================================
# Copy this file to .env and fill in all required values before deployment.
# Variables prefixed with VITE_ are exposed to the browser (client-side).
# All other variables are server-side only and should be kept SECRET.
# ============================================================================

# --- Supabase (Required) ---------------------------------------------------
# Get these from: https://supabase.com/dashboard → Project → Settings → API

# Client-side (exposed to browser — safe, these are "anon" keys)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Server-side (duplicated for SSR — same values as above)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Server-side admin key (KEEP SECRET — bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_SECRET_KEY="your-service-role-key"

# --- AI Provider (Required for AI features) --------------------------------
# Set OLLAMA_BASE_URL to any OpenAI-compatible API endpoint:
#   OpenAI:     https://api.openai.com/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:     http://localhost:11434/v1
#   Together:   https://api.together.xyz/v1
OLLAMA_BASE_URL="https://api.openai.com/v1"

# The model name to use (must be available at the provider above)
OLLAMA_MODEL="gpt-4o"

# API key for the AI provider (e.g., OpenAI API key, Google AI key)
AI_API_KEY="your-ai-api-key"

# --- Node.js (Optional) ----------------------------------------------------
NODE_OPTIONS="--max-old-space-size=8192"

# --- WhatsApp Notifications via Twilio (Optional) --------------------------
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_WHATSAPP_FROM="+14155238886"

# --- Email Notifications (Optional — TODO: configure provider) -------------
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="notifications@yourdomain.com"
